      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"INSERT INTO dbo.ResumenCargas (Leidos, Rechazados, EnRevision, Validos, DuplicadosDescartados, Cargados) VALUES (" + (DT_WSTR,10)@[User::RcLeidos] + "," + (DT_WSTR,10)@[User::RcRechazados] + "," + (DT_WSTR,10)@[User::RcRevision] + "," + (DT_WSTR,10)@[User::RcValidos] + "," + (DT_WSTR,10)(@[User::RcValidos] - @[User::RcCargados]) + "," + (DT_WSTR,10)@[User::RcCargados] + ")"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1848EE9D-2A2B-4ABF-AB05-4B9EE0A2402D}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.ResumenCargas (Leidos, Rechazados, EnRevision, Validos, DuplicadosDescartados, Cargados) VALUES (0,0,0,0,0,0)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
