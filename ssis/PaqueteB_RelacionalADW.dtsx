                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.TipoDocumento, p.NumeroDocumento, o.FechaEncuesta, m.CodigoMunicipio, o.Zona, n.NombreNivel,
       s.NombreSituacion, oc.NombreOcupacion, o.TipoContrato, o.IngresoMensual, o.GastoMensual, o.BalanceMensual
FROM dbo.Observaciones o
JOIN dbo.Personas p ON p.IdPersona = o.IdPersona
JOIN dbo.Municipios m ON m.IdMunicipio = o.IdMunicipio
JOIN dbo.NivelesEducativos n ON n.IdNivelEducativo = o.IdNivelEducativo
JOIN dbo.SituacionesLaborales s ON s.IdSituacionLaboral = o.IdSituacionLaboral
LEFT JOIN dbo.Ocupaciones oc ON oc.IdOcupacion = o.IdOcupacion</property>
